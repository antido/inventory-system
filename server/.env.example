# Port the API listens on
PORT=4000

# URL of the React app (used for CORS)
CLIENT_URL=http://localhost:5173

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=inventory_system

# Secret used to sign login tokens. Change this to a long random string!
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
